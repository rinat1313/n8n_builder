    {
      "parameters": {
        "jsCode": "const msg = $json.message;\nconst chatId = String(msg.chat.id);\nconst userText = String(msg.text);\nconst model = String($json.model || 'gemini-3.1-flash');\nconst chunkSize = Number($json.chunkSize) || 4000;\n\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.histories) staticData.histories = {};\nif (!staticData.logs) staticData.logs = [];\n\nconst history = Array.isArray(staticData.histories[chatId])\n  ? staticData.histories[chatId]\n  : [];\n\nconst contents = history.concat([\n  { role: 'user', parts: [{ text: userText }] },\n]);\n\nreturn [{\n  json: {\n    chatId,\n    userText,\n    model,\n    chunkSize,\n    requestBody: { contents },\n  },\n}];"
      },
      "id": "3a84afd9-25ee-4f4a-aeaa-3a95dc833c70",
      "name": "Code Prepare",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/{{ $json.model }}:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.requestBody }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "ca91bd50-cedf-40e9-84b7-7b1cdb64ffa6",
      "name": "HTTP Gemini",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1300,
        200
      ],
      "credentials": {
        "httpQueryAuth": {
          "id": "CHANGE_ME_GEMINI_CRED",
          "name": "Google AI Studio key (query: key)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const prep = $('Code Prepare').first().json;\nconst response = $input.first().json;\n\nif (response.error || response.error?.message) {\n  const staticData = $getWorkflowStaticData('global');\n  if (!staticData.logs) staticData.logs = [];\n  staticData.logs.push({\n    ts: new Date().toISOString(),\n    chatId: prep.chatId,\n    user: prep.userText,\n    error: response.error || response,\n  });\n  if (staticData.logs.length > 500) staticData.logs = staticData.logs.slice(-500);\n  return [];\n}\n\nconst parts = response?.candidates?.[0]?.content?.parts || [];\nconst assistantText = parts.map((p) => (p && p.text) || '').join('');\n\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.histories) staticData.histories = {};\nif (!staticData.logs) staticData.logs = [];\n\nlet history = Array.isArray(staticData.histories[prep.chatId])\n  ? staticData.histories[prep.chatId]\n  : [];\nhistory = history.concat([\n  { role: 'user', parts: [{ text: prep.userText }] },\n  { role: 'model', parts: [{ text: assistantText }] },\n]);\nif (history.length > 40) history = history.slice(-40);\nstaticData.histories[prep.chatId] = history;\n\nstaticData.logs.push({\n  ts: new Date().toISOString(),\n  chatId: prep.chatId,\n  user: prep.userText,\n  assistant: assistantText,\n});\nif (staticData.logs.length > 500) staticData.logs = staticData.logs.slice(-500);\n\nfunction chunkText(text, size) {\n  if (!text) return [];\n  const chunks = [];\n  let i = 0;\n  while (i < text.length) {\n    let end = Math.min(i + size, text.length);\n    if (end < text.length) {\n      const slice = text.slice(i, end);\n      const nl = slice.lastIndexOf('\\n');\n      if (nl > size * 0.5) end = i + nl + 1;\n    }\n    chunks.push(text.slice(i, end));\n    i = end;\n  }\n  return chunks;\n}\n\nconst chunks = chunkText(assistantText, prep.chunkSize);\nreturn chunks.map((text) => ({ json: { chatId: prep.chatId, text } }));"
      },
